# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories (build/, build_clean/, build_debug/, build_vs/, ...)
# Anchored to the repository root so vendored trees keep their build-* folders.
/build/
/Build/
/build*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files / local scratch
*.tmp
*.log
*.bak
*.swp
.tmp/

# Release archives belong in GitHub Releases, not in the tree
*.zip

# vcpkg
vcpkg_installed/

# The bundled toolchain and libraries keep their binaries: dependencies/cmake
# ships cmake.exe/ctest.exe and SDL ships prebuilt static libraries, which the
# exporter links into the packages (the rules above would hide them).
!/dependencies/**/*.exe
!/dependencies/**/*.dll
!/dependencies/**/*.lib
!/dependencies/**/*.a

# debug information files
*.dwo

# test output & cache
Testing/
.cache/
